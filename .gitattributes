* text=auto eol=lf

# 源码与文档
*.py    text eol=lf
*.md    text
*.yaml  text
*.yml   text
*.txt   text
*.csv   text eol=lf
*.ps1   text eol=crlf

# 二进制资产
*.png binary
*.jpg binary
*.jpeg binary
*.mp4 binary
*.pt  binary
*.onnx binary

# CAD 原始文件
*.SLDASM binary
*.SLDPRT binary
*.DXF    binary

